[Unit]
Description=reSpeaker OpenClaw Realtime Talk bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openclaw
Group=openclaw
WorkingDirectory=/opt/respeaker-openclaw-talk/bridge
EnvironmentFile=/etc/respeaker-talk-bridge/env
ExecStart=/usr/bin/node /opt/respeaker-openclaw-talk/bridge/dist/src/index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/respeaker-talk-bridge

[Install]
WantedBy=multi-user.target
