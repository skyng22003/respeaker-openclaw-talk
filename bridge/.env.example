# Copy to a host-private, mode-0600 environment file. Never commit the real file.
# The ESP32 stores only DEVICE_CREDENTIAL. GATEWAY_TOKEN stays on this host.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
DEVICE_CREDENTIAL=replace-with-a-random-device-secret
GATEWAY_URL=ws://127.0.0.1:18789
GATEWAY_TOKEN=obtain-from-the-host-protected-Gateway-configuration
TALK_SESSION_KEY=main
