# Copy to a host-private, mode-0600 environment file. Never commit the real file.
# The ESP32 stores only DEVICE_CREDENTIAL. Gateway device credentials stay on this host.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
DEVICE_CREDENTIAL=replace-with-a-random-device-secret
GATEWAY_URL=ws://127.0.0.1:18789
GATEWAY_DEVICE_TOKEN=obtain-by-pairing-this-bridge-with-operator-talk-only
GATEWAY_DEVICE_ID=paired-device-id
GATEWAY_DEVICE_PUBLIC_KEY_FILE=/run/secrets/gateway-device-public.pem
GATEWAY_DEVICE_PRIVATE_KEY_FILE=/run/secrets/gateway-device-private.pem
TALK_SESSION_KEY=main
