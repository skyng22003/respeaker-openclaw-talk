# Copy this file to secrets.yaml and set your own values.
# Keep secrets.yaml out of version control.

wifi_ssid: "YOUR_WIFI_NAME"
wifi_password: "YOUR_WIFI_PASSWORD"

# Password for over-the-air updates. Choose your own.
ota_password: "YOUR_OTA_PASSWORD"

# Home Assistant API encryption key.
# Generate a new key at https://esphome.io/components/api.html
api_key: "YOUR_BASE64_API_ENCRYPTION_KEY"

# Device-to-bridge endpoint and this device's unique credential. Never use the
# OpenClaw Gateway credential here.
realtime_bridge_url: "ws://BRIDGE_LAN_HOST:8787/device"
realtime_bridge_credential: "YOUR_UNIQUE_DEVICE_BRIDGE_CREDENTIAL"
